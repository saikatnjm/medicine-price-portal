{
  "name": "bangladesh-healthcare-search",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node -e \"for (const d of ['.next/types', '.next/dev/types']) require('fs').rmSync(d, { recursive: true, force: true })\" && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run validate:data && npm run lint && npm run typecheck && npm run test && npm run build",
    "data:fetch": "node scripts/data/fetch-dgda.mjs",
    "data:build": "node scripts/data/build-catalog.mjs",
    "validate:data": "node scripts/data/validate-data.mjs",
    "data:fetch-osm": "node scripts/data/fetch-osm-health.mjs",
    "data:fetch-areas": "node scripts/data/fetch-areas.mjs",
    "data:fetch-osm-areas": "node scripts/data/fetch-osm-areas.mjs",
    "data:build-healthcare": "node scripts/data/build-healthcare.mjs",
    "data:import-doctors": "node scripts/data/import-doctors.mjs",
    "data:match-google-places": "node scripts/data/match-google-places.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
