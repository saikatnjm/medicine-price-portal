# Copy to .env for local overrides. Never commit real secrets.

# Public base URL used for canonical URLs, OpenGraph and the sitemap.
# NEXT_PUBLIC_* values are inlined at build time. On Vercel, if unset, the
# production domain (VERCEL_PROJECT_PRODUCTION_URL) is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Allow search engines to index the site. Keep "false" while prices are sample data.
# Vercel preview deployments are never indexable regardless of this value.
SITE_INDEXABLE=false

# Optional: Google Maps Embed API key for the click-to-load map preview.
# Without it, the preview uses OpenStreetMap and "Get directions" / "View on
# Google Maps" links still work (they need no key). This key is public by
# design: restrict it to the Maps Embed API and your domains in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
