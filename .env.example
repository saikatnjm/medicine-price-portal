# Copy to .env for local overrides. Never commit real secrets.

# Public base URL used for canonical URLs, OpenGraph and the sitemap.
# NEXT_PUBLIC_* values are inlined at build time. On Vercel, if unset, the
# production domain (VERCEL_PROJECT_PRODUCTION_URL) is used.
# Production (set in Vercel, not here): NEXT_PUBLIC_SITE_URL=https://bdhealthsearch.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Allow search engines to index the site. Keep "false" while prices are sample data.
# Vercel preview deployments are never indexable regardless of this value.
SITE_INDEXABLE=false

# Optional: Google Maps Embed API key for the click-to-load map preview.
# Without it, the preview uses OpenStreetMap and "Get directions" / "View on
# Google Maps" links still work (they need no key). This key is public by
# design: restrict it to the Maps Embed API and your domains in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Optional: where the "Report this information" link on hospital and pharmacy
# pages sends people. A mailto: address (mailto:reports@example.org) or an https
# form URL; "?subject=..." is appended. Leave empty to hide the link.
NEXT_PUBLIC_REPORT_URL=

# Optional Google Places enrichment (server-only; never prefix with NEXT_PUBLIC_).
# Used by `npm run data:match-google-places` and, with GOOGLE_PLACES_LIVE_DETAILS=true,
# to show a live "Google rating" on listings that have a stored place ID.
# Both unset = no Google information beyond key-free Maps links. See data/google/README.md.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_LIVE_DETAILS=false

# Optional: where visitors can report an error in a listing (shown on /about).
NEXT_PUBLIC_REPORT_URL=

# Optional: Google Analytics 4 measurement id (looks like G-XXXXXXXXXX).
# Public by design. Analytics loads only when this is set, and never on
# Vercel preview deployments. Leave empty locally.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
